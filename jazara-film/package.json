{
  "name": "jazara-film",
  "version": "1.0.0",
  "private": true,
  "description": "Jazara Media Group - 20s brand film (Remotion)",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "still": "remotion still src/index.ts JazaraFilm --browser-executable=/opt/pw-browsers/chromium_headless_shell-1194/chrome-linux/headless_shell",
    "render": "remotion render src/index.ts JazaraFilm out/jazara-film.mp4 --codec=h264 --crf=14 --browser-executable=/opt/pw-browsers/chromium_headless_shell-1194/chrome-linux/headless_shell",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@remotion/bundler": "4.0.534",
    "@remotion/cli": "4.0.534",
    "@remotion/motion-blur": "4.0.534",
    "@remotion/paths": "4.0.534",
    "@remotion/renderer": "4.0.534",
    "@remotion/shapes": "4.0.534",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
